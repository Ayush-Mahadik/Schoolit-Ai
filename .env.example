# PROLAI (formerly SchoolIT AI) - Environment Variables Template
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local with real secrets!

# Leave empty for Vercel (uses relative /api/* routes)
NEXT_PUBLIC_API_URL=

# Public site URLs (used for metadata + domain banner)
NEXT_PUBLIC_SITE_URL=https://prolai.me
NEXT_PUBLIC_OLD_SITE_URL=https://schoolit-ai.vercel.app

# Self-hosted LLM (Oracle / DigitalOcean with OpenAI-compatible API)
SELF_HOSTED_LLM_URL=https://prolai-llm.your-domain.com/v1
SELF_HOSTED_LLM_MODEL_ID=prolai-llm
SELF_HOSTED_LLM_API_KEY=change-me-if-your-server-requires-a-key

# GitHub Models AI - Get token from github.com/settings/tokens
GITHUB_TOKEN=your-github-token-here
AI_BASE_URL=https://models.inference.ai.azure.com
AI_MODEL=gpt-4o

# NextAuth - Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-random-secret-here
NEXTAUTH_URL=https://prolai.me

# Google OAuth - Get from console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Admin emails (comma-separated) - these accounts bypass rate limiting
ADMIN_EMAILS=your-email@example.com
