# SchoolIT AI - Environment Variables Template
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local with real secrets!

# Leave empty for Vercel (uses relative /api/* routes)
NEXT_PUBLIC_API_URL=

# GitHub Models AI - Get token from github.com/settings/tokens
GITHUB_TOKEN=your-github-token-here
AI_BASE_URL=https://models.inference.ai.azure.com
AI_MODEL=gpt-4o

# NextAuth - Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-random-secret-here
NEXTAUTH_URL=https://schoolit-ai.vercel.app

# Google OAuth - Get from console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Admin emails (comma-separated) - these accounts bypass rate limiting
ADMIN_EMAILS=your-email@example.com
